#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: md2pdf INPUT.md [OUTPUT.pdf]" >&2
  exit 2
fi

input=$1
output=${2:-"${input%.*}.pdf"}
[[ -f "$input" ]] || { echo "File not found: $input" >&2; exit 1; }
command -v pandoc >/dev/null || { echo 'pandoc is required' >&2; exit 1; }

pdf_engine=''
for candidate in pdflatex xelatex lualatex tectonic wkhtmltopdf weasyprint; do
  if command -v "$candidate" >/dev/null 2>&1; then
    pdf_engine=$candidate
    break
  fi
done
[[ -n "$pdf_engine" ]] || {
  echo 'A PDF engine is required (for example: sudo apt install texlive-latex-base)' >&2
  exit 1
}

pandoc --from=gfm --pdf-engine="$pdf_engine" "$input" --output="$output"
printf '%s -> %s\n' "$input" "$output"
