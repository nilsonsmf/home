#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo 'Usage: video2gif INPUT_VIDEO [OUTPUT.gif]' >&2
  exit 2
fi
input=$1
output=${2:-"${input%.*}.gif"}
[[ -f "$input" ]] || { echo "File not found: $input" >&2; exit 1; }
command -v ffmpeg >/dev/null || { echo 'ffmpeg is required' >&2; exit 1; }
ffmpeg -hide_banner -i "$input" -vf "fps=10,scale=800:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" -loop 0 "$output"
