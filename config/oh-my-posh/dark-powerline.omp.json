{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} • {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        { "type": "session", "style": "powerline", "powerline_symbol": "\ue0b0", "background": "#1E293B", "foreground": "#E2E8F0", "template": " \uf007 {{ .UserName }} " },
        { "type": "path", "style": "powerline", "powerline_symbol": "\ue0b0", "background": "#334155", "foreground": "#67E8F9", "options": { "style": "full", "folder_separator_icon": " / " }, "template": " \uf07b {{ .Path }} " }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git", "style": "powerline", "powerline_symbol": "\ue0b2", "invert_powerline": true,
          "background": "#7C3AED", "foreground": "#F5F3FF",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#DB2777{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#DC2626{{ end }}",
            "{{ if gt .Ahead 0 }}#0891B2{{ end }}",
            "{{ if gt .Behind 0 }}#EA580C{{ end }}"
          ],
          "template": " \ue725 {{ .HEAD }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        },
        { "type": "time", "style": "powerline", "powerline_symbol": "\ue0b2", "invert_powerline": true, "background": "#0F766E", "foreground": "#CCFBF1", "template": " \uf017 {{ .CurrentDate | date .Format }} ", "properties": { "time_format": "15:04" } }
      ]
    },
    { "type": "prompt", "alignment": "left", "newline": true, "segments": [{ "type": "text", "style": "plain", "foreground": "#22D3EE", "template": "❯ " }] }
  ],
  "transient_prompt": { "background": "transparent", "foreground": "#22D3EE", "template": "❯ " }
}
